# Firebase Configuration for CMS Application
# Instructions:
# 1. Go to Firebase Console (https://console.firebase.google.com/)
# 2. Create a new project or select an existing one
# 3. Enable Authentication (Email/Password provider)
# 4. Enable Cloud Firestore (in test mode or production rules)
# 5. Register a Web App under Project Settings to get these credentials
# 6. Copy this file to .env and fill in your values

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=
